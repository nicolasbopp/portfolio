# Copy to .env.local for local development; set the same values in your hosting provider.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Where contact form messages are delivered
CONTACT_TO=

# Sender address. Must use a domain verified in Resend, e.g. "Portfolio <contact@yourdomain.com>".
# Without a verified domain, "Portfolio <onboarding@resend.dev>" works, but only delivers to your Resend account email.
CONTACT_FROM=

# Public URL of the site, used for social preview links
SITE_URL=
